# Interface de rede do servidor HTTP (padrão: 0.0.0.0 para escutar em todas as interfaces)
SERVER_HOST=0.0.0.0

# Porta do servidor HTTP (padrão: 3000)
SERVER_PORT=3000

# Caminho do banco SQLite (padrão: ./data/sbsmonitor.db)
# Para PostgreSQL futuro: altere createDatabase() em apps/server/db/index.ts
DATABASE_URL=./data/sbsmonitor.db

# Segredo HMAC-SHA256 para assinar tokens JWT do painel administrativo
# Gere um valor seguro com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-seguro-em-producao

# API do WhatsApp usada para alertas de métricas.
# Contrato atual: POST ${WHATSAPP_API_URL}/send/text
# body: { "number": "...", "text": "..." } com header apikey.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Identificador do grupo no provedor WhatsApp.
# O servidor trata este valor como opaco e envia no campo "number".
WHATSAPP_ALERT_GROUP_ID=

# Limites globais de alerta em porcentagem (0 a 100).
# O alerta dispara quando o valor recebido for maior ou igual ao limite.
ALERT_CPU_THRESHOLD_PCT=90
ALERT_MEMORY_THRESHOLD_PCT=90
ALERT_DISK_THRESHOLD_PCT=90

# HTTPS endpoint of the SBSMonitor server (required)
SERVER_URL=https://monitor.example.com

# Unique agent credentials (required)
AGENT_ID=agent-001
AGENT_SECRET=change-me-to-a-strong-secret

# Collection interval in seconds and request timeout in milliseconds
COLLECT_INTERVAL=60
REQUEST_TIMEOUT=10000

# Optional PEM file containing an internal certificate authority.
# The file may contain one or more CA certificates and is added to WebPKI roots.
# CA_CERT_PATH=C:\Program Files\SBSMonitor\internal-ca.pem

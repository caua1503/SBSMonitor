# Endereço do Server
SERVER_URL=http://localhost:3000

# Identificador único do Agent (obrigatório)
AGENT_ID=agent-001

# Chave de autenticação do Agent (obrigatório)
AGENT_SECRET=change-me-to-a-strong-secret

# Intervalo de coleta em segundos (padrão: 60)
COLLECT_INTERVAL=60

# Timeout das requisições HTTP em milissegundos (padrão: 10000)
REQUEST_TIMEOUT=10000
